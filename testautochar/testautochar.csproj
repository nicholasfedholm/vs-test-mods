<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>testautochar</AssemblyName>
    <RootNamespace>TestAutoChar</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VINTAGE_STORY)' == ''">
    <VINTAGE_STORY>$(APPDATA)\Vintagestory</VINTAGE_STORY>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VINTAGE_STORY)\Mods\VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VINTAGE_STORY)\Lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
